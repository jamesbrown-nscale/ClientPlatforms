# Client Platforms stack settings. In Portainer, add these under the stack's Environment variables
# (or "Load variables from .env file"). Never commit a filled-in copy.

# --- Sign-in ---
# cloudflare: Cloudflare Access signs people in (no passwords here).
# local:      email and password, kept by the portal.
AUTH_MODE=cloudflare
# Shared by all services: the portal signs who someone is with it, the tools check it.
# openssl rand -hex 32
AUTH_SECRET=
# The first admin. Used only while the portal has no accounts; then manage people under Settings.
ADMIN_EMAIL=you@nscale.com
# AUTH_MODE=local only: the first admin's password (change it after signing in).
ADMIN_PASSWORD=

# AUTH_MODE=cloudflare: Zero Trust → Access → Applications → your app → Overview.
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=
# Zero Trust → Networks → Tunnels → your tunnel → the token in the install command.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Addresses (defaults; change them later under Settings) ---
PUBLIC_URL=https://clientplatforms.nscale.com
DEVICE_URL=
HTTP_PORT=8080

# --- Device keys ---
# IT Notifications: one shared enrollment key. openssl rand -hex 24
ENROLLMENT_KEY=
# Elevation and Restart Reminder: label:key pairs, comma separated, keys 24+ characters,
# e.g. laptops:<openssl rand -hex 24>,servers:<openssl rand -hex 24>
ELEVATION_INGEST_KEYS=
RESTART_INGEST_KEYS=

# --- Tool options ---
NOTIFY_ADMIN_EMAILS=
ALLOWED_LINK_HOSTS=nscale.com
MAX_UPTIME_DAYS=3
COUNTDOWN_HOURS=3
LATEST_SCHEDULE_TIME=17:00
