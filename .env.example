# Client Platforms on your own machine: copy to .env next to docker-compose.yml, fill in, then
#   docker compose up -d --build        and open http://localhost:8080
# Never commit a filled-in copy. The Google Cloud VM has its own: deploy/vm/env.example.

# --- Sign-in ---
# local: an email and password, kept by the portal (the VM uses oidc: see deploy/vm/README.md).
AUTH_MODE=local
# Shared by all services: the portal signs who someone is with it, the tools check it.
# openssl rand -hex 32
AUTH_SECRET=
# The first admin, created while the portal has no accounts; then manage people under Settings.
ADMIN_EMAIL=you@nscale.com
ADMIN_PASSWORD=

# --- Addresses (defaults; change them later under Settings) ---
PUBLIC_URL=
DEVICE_URL=
HTTP_PORT=8080

# --- Device keys ---
# IT Notifications: one shared enrollment key. openssl rand -hex 24
ENROLLMENT_KEY=
# Elevation and Restart Reminder: label:key pairs, comma separated, keys 24+ characters,
# e.g. laptops:<openssl rand -hex 24>,servers:<openssl rand -hex 24>
ELEVATION_INGEST_KEYS=
RESTART_INGEST_KEYS=

# --- Tool options ---
NOTIFY_ADMIN_EMAILS=
ALLOWED_LINK_HOSTS=nscale.com
MAX_UPTIME_DAYS=3
COUNTDOWN_HOURS=3
LATEST_SCHEDULE_TIME=17:00
# App Packaging: how long a package can be downloaded, the most kept in all (the oldest go first), the biggest upload.
PACKAGING_KEEP_DAYS=7
PACKAGING_MAX_TOTAL_GB=5
PACKAGING_MAX_UPLOAD_MB=2048
# Devices: how often to read Jamf and Intune again, in minutes (connect them under Settings → Connections).
SYNC_MINUTES=60
