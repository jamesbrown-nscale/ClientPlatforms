# Client Platforms front door (Docker: the Google Cloud VM, or your own machine).
#
#   /notifications/*  IT Notifications      /elevation/*  admin elevation log
#   /restart/*        Restart Reminder      /projects/*   Projects      /tasks/*   Tasks      /team/*   Team
#   /inbox/*          your notifications   /changes/*   Change management
#   /devices/*        Devices (Jamf, Intune) /users/*   Users   /org/*   Org chart   /departments/*   Departments
#   everything else: the portal (home, sign-in, settings)
#
# Before a request reaches a tool, Caddy asks the portal (/auth/check) whether the person is signed
# in and allowed that tool. The portal answers with X-CP-User, a short-lived signed token the tool
# checks itself. Device endpoints skip that: they use their own keys.
{
	admin off
	servers {
		# Facing the internet itself (the VM), trust nobody's headers: TRUSTED_PROXIES=127.0.0.1/32.
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
		client_ip_headers X-Forwarded-For
	}
}

(to) {
	reverse_proxy {args[0]}:8080 {
		header_up X-Forwarded-For {client_ip}
	}
}

(signed_in) {
	forward_auth portal:8080 {
		uri /auth/check
		header_up X-Forwarded-For {client_ip}
		copy_headers X-CP-User
	}
}

{$SITE_ADDRESS::80} {
	encode gzip
	# Only the portal may say who someone is.
	request_header -X-CP-User
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		# Unless the app says otherwise (the Document Library shows PDFs in its own page: SAMEORIGIN).
		?X-Frame-Options DENY
		-Server
	}

	# Devices: no sign-in, their own keys (each app slows down wrong keys). Reports are small, so
	# anything bigger is turned away before it reaches the app.
	handle /notifications/api/v1/checkin {
		request_body {
			max_size 2MB
		}
		import to notifications
	}
	handle /elevation/api/elevations/ingest {
		request_body {
			max_size 2MB
		}
		import to elevation
	}
	handle /restart/api/reports {
		request_body {
			max_size 2MB
		}
		import to restart
	}
	handle /restart/api/policy {
		import to restart
	}

	# People: signed in, and allowed that tool.
	@notifications path /notifications /notifications/*
	handle @notifications {
		import signed_in
		import to notifications
	}
	@elevation path /elevation /elevation/*
	handle @elevation {
		import signed_in
		import to elevation
	}
	@restart path /restart /restart/*
	handle @restart {
		import signed_in
		import to restart
	}
	@projects path /projects /projects/*
	handle @projects {
		import signed_in
		import to projects
	}
	# Tasks and Team run in the projects service (one database: tasks belong to projects, and
	# each team member's projects and activity come from there).
	@tasks path /tasks /tasks/*
	handle @tasks {
		import signed_in
		import to projects
	}
	@team path /team /team/*
	handle @team {
		import signed_in
		import to projects
	}
	@changes path /changes /changes/*
	handle @changes {
		import signed_in
		import to projects
	}
	# Everyone's own notifications (any signed-in person; see the portal's EVERYONE).
	@inbox path /inbox /inbox/*
	handle @inbox {
		import signed_in
		import to projects
	}

	# Users and Devices run in the inventory service (one database: a user's primary device is one
	# of the devices). Settings → Connections reads and saves /devices/api/connections.
	@devices path /devices /devices/*
	handle @devices {
		import signed_in
		import to inventory
	}
	@users path /users /users/*
	handle @users {
		import signed_in
		import to inventory
	}
	# Org chart and Departments: read-only views of Users, each with its own access.
	@org path /org /org/*
	handle @org {
		import signed_in
		import to inventory
	}
	@departments path /departments /departments/*
	handle @departments {
		import signed_in
		import to inventory
	}

	handle /proxy-health {
		respond "ok" 200
	}

	handle {
		import to portal
	}
}
