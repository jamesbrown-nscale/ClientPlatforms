# Client Platforms on the Google Cloud VM. setup.sh copies this to /opt/client-platforms/.env and
# fills in the random secrets; fill in the rest. Never commit a filled-in copy.

# --- The site ---
# The name people and devices use. Point its DNS A record at the VM's address (create.sh prints it).
DOMAIN=clientplatforms.nscale.com

# --- Sign-in: OpenID Connect ---
AUTH_MODE=oidc
# Shared by all services (setup.sh makes it).
AUTH_SECRET=
# Google: https://accounts.google.com   Okta (later): https://<your-org>.okta.com
OIDC_ISSUER=https://accounts.google.com
# Google Cloud console, APIs & Services, Credentials, OAuth client (Web application, "Internal"),
# with the authorised redirect URI  https://<DOMAIN>/auth/callback
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Shown on the button ("Sign in with Google"). Worked out from the issuer if empty.
OIDC_PROVIDER_NAME=
OIDC_ALLOWED_DOMAINS=nscale.com

# --- The first admin and break-glass ---
# Created when the site starts with no accounts; sign in with OIDC as normal. This account (and any
# others listed in BREAK_GLASS_EMAILS) can also use the password below if sign-in is ever down.
ADMIN_EMAIL=
# setup.sh makes a long random one. Keep it somewhere safe (a password manager), not on paper.
ADMIN_PASSWORD=
# Comma separated; empty means just ADMIN_EMAIL.
BREAK_GLASS_EMAILS=

# --- Finding people when adding them ---
# google: the Google Workspace directory (create.sh prints the client ID to allow in the Admin
#         console); okta: Okta's directory. Empty: admins type the email.
DIRECTORY=google
# A Google Workspace admin the search acts as (read-only). Any admin who can see users.
DIRECTORY_GOOGLE_ADMIN=
# Okta (later): the org address and a read-only API token.
OKTA_ORG_URL=
OKTA_API_TOKEN=

# --- Device keys (setup.sh makes them; put the same ones in the device agents) ---
# IT Notifications: one shared enrollment key.
ENROLLMENT_KEY=
# Elevation and Restart Reminder: label:key pairs, comma separated, keys 24+ characters. One label
# per group of devices, so one group can be cut off without the others.
ELEVATION_INGEST_KEYS=
RESTART_INGEST_KEYS=

# --- Tool options ---
NOTIFY_ADMIN_EMAILS=
ALLOWED_LINK_HOSTS=nscale.com
MAX_UPTIME_DAYS=3
COUNTDOWN_HOURS=3
LATEST_SCHEDULE_TIME=17:00
SESSION_HOURS=12
