{
 "phases": [
  "Discovery",
  "Pilot",
  "Waves",
  "Hypercare",
  "Close",
  "Post-Migration Delivery & Technical Implementation"
 ],
 "modules": [
  {
   "key": "statusReports",
   "navGroup": "Overview",
   "label": "Status Reports",
   "singular": "Status Report",
   "icon": "status",
   "description": "Weekly highlight reports with an overall RAG status. The latest report sets the project’s RAG.",
   "titleField": "periodEnding",
   "refPrefix": "SR-",
   "columns": [
    "ref",
    "periodEnding",
    "overallRag",
    "scheduleRag",
    "budgetRag",
    "scopeRag",
    "risksRag",
    "phase",
    "author"
   ],
   "fields": [
    {
     "key": "periodEnding",
     "label": "Week ending",
     "type": "date",
     "required": true,
     "defaultToday": true
    },
    {
     "key": "phase",
     "label": "Current phase",
     "type": "select",
     "options": [
      "Discovery",
      "Pilot",
      "Waves",
      "Hypercare",
      "Close",
      "Post-Migration Delivery & Technical Implementation"
     ]
    },
    {
     "key": "overallRag",
     "label": "Overall RAG",
     "type": "rag",
     "options": [
      "Green",
      "Amber",
      "Red"
     ],
     "required": true,
     "default": "Green",
     "width": "full"
    },
    {
     "key": "scheduleRag",
     "label": "Schedule",
     "type": "rag",
     "options": [
      "Green",
      "Amber",
      "Red"
     ],
     "default": "Green"
    },
    {
     "key": "budgetRag",
     "label": "Budget",
     "type": "rag",
     "options": [
      "Green",
      "Amber",
      "Red"
     ],
     "default": "Green"
    },
    {
     "key": "scopeRag",
     "label": "Scope",
     "type": "rag",
     "options": [
      "Green",
      "Amber",
      "Red"
     ],
     "default": "Green"
    },
    {
     "key": "risksRag",
     "label": "Risks & issues",
     "type": "rag",
     "options": [
      "Green",
      "Amber",
      "Red"
     ],
     "default": "Green"
    },
    {
     "key": "summary",
     "label": "Executive summary",
     "type": "textarea",
     "required": true,
     "placeholder": "Where the project stands this week, in two or three sentences…"
    },
    {
     "key": "achievements",
     "label": "Achieved this period",
     "type": "textarea",
     "placeholder": "Milestones reached, actions completed…"
    },
    {
     "key": "nextSteps",
     "label": "Planned next period",
     "type": "textarea",
     "placeholder": "What happens next…"
    },
    {
     "key": "keyRisks",
     "label": "Key risks & issues",
     "type": "textarea",
     "placeholder": "Anything threatening delivery…"
    },
    {
     "key": "decisionsNeeded",
     "label": "Decisions / help needed",
     "type": "textarea",
     "placeholder": "Escalations for the sponsor or board…"
    },
    {
     "key": "author",
     "label": "Author",
     "type": "user",
     "placeholder": "Who wrote this report"
    }
   ]
  },
  {
   "key": "milestones",
   "navGroup": "Overview",
   "label": "Timeline",
   "singular": "Milestone",
   "icon": "timeline",
   "description": "Phases and key dates from Discovery through Pilot, Waves, Hypercare and Close to post-migration delivery.",
   "titleField": "title",
   "refPrefix": "MS-",
   "view": "timeline",
   "template": {
    "label": "Add standard phase plan",
    "kind": "phasePlan"
   },
   "quickAction": {
    "field": "status",
    "value": "Complete",
    "label": "Complete",
    "hideWhen": [
     "Complete"
    ]
   },
   "columns": [
    "ref",
    "title",
    "phase",
    "type",
    "startDate",
    "endDate",
    "owner",
    "status"
   ],
   "fields": [
    {
     "key": "title",
     "label": "Title",
     "type": "text",
     "required": true,
     "width": "full",
     "placeholder": "e.g. Pilot go / no-go"
    },
    {
     "key": "phase",
     "label": "Phase",
     "type": "select",
     "options": [
      "Discovery",
      "Pilot",
      "Waves",
      "Hypercare",
      "Close",
      "Post-Migration Delivery & Technical Implementation"
     ],
     "required": true,
     "default": "Discovery",
     "width": "third"
    },
    {
     "key": "type",
     "label": "Type",
     "type": "select",
     "options": [
      "Milestone",
      "Phase"
     ],
     "default": "Milestone",
     "width": "third"
    },
    {
     "key": "status",
     "label": "Status",
     "type": "select",
     "options": [
      "Not Started",
      "In Progress",
      "Complete",
      "At Risk",
      "Delayed"
     ],
     "default": "Not Started",
     "width": "third"
    },
    {
     "key": "startDate",
     "label": "Start date",
     "type": "date",
     "hint": "Leave empty for a single key date."
    },
    {
     "key": "endDate",
     "label": "End / due date",
     "type": "date",
     "required": true
    },
    {
     "key": "owner",
     "label": "Owner",
     "type": "user",
     "width": "full",
     "placeholder": "Who is accountable"
    },
    {
     "key": "description",
     "label": "Description",
     "type": "textarea",
     "placeholder": "Scope, entry and exit criteria…"
    },
    {
     "key": "order",
     "label": "Order",
     "type": "number",
     "hidden": true
    }
   ]
  },
  {
   "key": "risks",
   "navGroup": "RAID",
   "label": "Risk Register",
   "singular": "Risk",
   "icon": "risks",
   "description": "Potential problems rated by likelihood × impact: Critical 20–25, High 12–19, Medium 6–11, Low 1–5.",
   "titleField": "title",
   "refPrefix": "RSK-",
   "filters": [
    "category",
    "status",
    "owner"
   ],
   "columns": [
    "ref",
    "title",
    "category",
    "likelihood",
    "impact",
    "score",
    "owner",
    "status"
   ],
   "fields": [
    {
     "key": "title",
     "label": "Title",
     "type": "text",
     "required": true,
     "width": "full",
     "placeholder": "Short summary of the risk"
    },
    {
     "key": "description",
     "label": "Description",
     "type": "textarea",
     "required": true,
     "placeholder": "Describe the risk…"
    },
    {
     "key": "category",
     "label": "Category",
     "type": "select",
     "options": [
      "Technical",
      "Security",
      "Compliance",
      "Schedule",
      "Budget",
      "Resource",
      "Vendor",
      "Operational"
     ],
     "default": "Technical"
    },
    {
     "key": "status",
     "label": "Status",
     "type": "select",
     "options": [
      "Open",
      "Mitigating",
      "Accepted",
      "Closed"
     ],
     "default": "Open"
    },
    {
     "key": "likelihood",
     "label": "Likelihood (1–5)",
     "type": "scale",
     "options": [
      "1",
      "2",
      "3",
      "4",
      "5"
     ],
     "default": "3",
     "required": true,
     "width": "third"
    },
    {
     "key": "impact",
     "label": "Impact (1–5)",
     "type": "scale",
     "options": [
      "1",
      "2",
      "3",
      "4",
      "5"
     ],
     "default": "3",
     "required": true,
     "width": "third"
    },
    {
     "key": "score",
     "label": "Risk Rating",
     "type": "computed",
     "width": "third"
    },
    {
     "key": "raisedBy",
     "label": "Raised By",
     "type": "user",
     "placeholder": "Who identified it"
    },
    {
     "key": "owner",
     "label": "Owner",
     "type": "user",
     "placeholder": "Risk owner name"
    },
    {
     "key": "mitigation",
     "label": "Mitigation",
     "type": "textarea",
     "placeholder": "Steps to reduce likelihood/impact…"
    },
    {
     "key": "contingency",
     "label": "Contingency",
     "type": "textarea",
     "placeholder": "Steps to take if the risk occurs…"
    },
    {
     "key": "updates",
     "label": "Updates",
     "type": "updates",
     "width": "full"
    }
   ]
  },
  {
   "key": "assumptions",
   "navGroup": "RAID",
   "label": "Assumptions",
   "singular": "Assumption",
   "icon": "assumptions",
   "description": "Things the plan takes as true, e.g. “Intune licences procured before the pilot”. Validate them before they bite.",
   "titleField": "title",
   "refPrefix": "ASM-",
