     "options": [
      "Technical",
      "Licensing",
      "Commercial",
      "Resource",
      "Schedule",
      "Business"
     ],
     "default": "Technical",
     "width": "third"
    },
    {
     "key": "validateBy",
     "label": "Validate by",
     "type": "date",
     "width": "third"
    },
    {
     "key": "status",
     "label": "Status",
     "type": "select",
     "options": [
      "Open",
      "Validated",
      "Invalid",
      "Closed"
     ],
     "default": "Open",
     "width": "third"
    },
    {
     "key": "owner",
     "label": "Owner",
     "type": "user",
     "width": "full",
     "placeholder": "Who will confirm it"
    },
    {
     "key": "impactIfWrong",
     "label": "Impact if wrong",
     "type": "textarea",
     "placeholder": "What happens to the plan if this turns out to be false…"
    },
    {
     "key": "updates",
     "label": "Updates",
     "type": "updates",
     "width": "full"
    }
   ]
  },
